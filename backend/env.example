# Production Environment Variables
# Copy this to .env and fill in your actual values

# Environment
NODE_ENV=production

# Server Configuration
PORT=3011

# Database
# Get this from MongoDB Atlas or your MongoDB provider
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/attendance-db?retryWrites=true&w=majority

# JWT Configuration - RS256 with RSA Key Pairs
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256

# Session Configuration
SESSION_SECRET=your_secure_session_secret_here_minimum_32_characters

# Legacy JWT_SECRET (DEPRECATED - will be removed in future versions)
# JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters

# Application URL
FRONTEND_URL=https://yourdomain.com

# Email Configuration (Optional - for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@yourdomain.com

# Company name used in system-generated emails (e.g. document forward emails)
COMPANY_NAME=Your Company Name

# Email Notifications Control
DISABLE_HR_EMAILS=false
DISABLE_ALL_EMAILS=false

# SSO Configuration (Optional)
SSO_ENABLED=true
SSO_SECRET=sso-secret-key-change-in-production
SSO_ISSUER=sso-portal
SSO_AUDIENCE=sso-apps
SSO_AUTO_PROVISION=true
SSO_PORTAL_URL=http://localhost:3003
SSO_JWKS_URL=http://localhost:3003/.well-known/jwks.json
SSO_PUBLIC_KEY_URL=http://localhost:3003/api/auth/public-key
SSO_VALIDATE_URL=http://localhost:3003/api/auth/validate

# Redis Configuration (Optional - for advanced caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Allowed Origins for CORS (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com



# ─── Backblaze B2 (KYC Document Storage — S3-compatible) ─────────────────────
# Bucket must be PRIVATE. All access goes through short-lived presigned URLs.
# Get the Key ID + Application Key from the Backblaze dashboard:
#   My Account → App Keys → Add a New Application Key (read+write on this bucket only)
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# ─── salary-service integration (internal payroll feed) ──────────────────────
# Shared secret between AMS and salary-service for the /internal/payroll-feed
# endpoint. Set the SAME value in salary-service's .env as SERVICE_TOKEN.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If not set, the internal feed route returns 503 rather than silently allowing
# unauthenticated access.
SERVICE_TOKEN=REPLACE_WITH_96_CHAR_HEX_TOKEN
